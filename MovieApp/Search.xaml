<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MovieApp.Search"
    BackgroundColor="{Binding BackgroundColor}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Search Bar -->
        <Grid Grid.Row="0" Margin="15" ColumnDefinitions="*,Auto">
            <Border Grid.Column="0"
                    BackgroundColor="{Binding SearchBarBackground}"
                    Stroke="{Binding BorderColor}"
                    StrokeThickness="1"
                    Padding="15,10"
                    Margin="0,0,10,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Entry x:Name="SearchEntry"
                       Placeholder="Search movies..."
                       PlaceholderColor="{Binding SubtextColor}"
                       TextChanged="SearchEntry_TextChanged"
                       BackgroundColor="Transparent"
                       TextColor="{Binding TextColor}"
                       HorizontalOptions="FillAndExpand"/>
            </Border>

            <Button x:Name="ClearButton"
                    Grid.Column="1"
                    Text="✕"
                    Clicked="ClearSearch_Clicked"
                    IsVisible="False"
                    BackgroundColor="{Binding AccentColor}"
                    TextColor="Black"
                    FontSize="18"
                    FontAttributes="Bold"
                    WidthRequest="44"
                    HeightRequest="44"
                    CornerRadius="12"/>
        </Grid>

        <!-- Genre Chips -->
        <ScrollView Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    Margin="0,5,0,10">
            <HorizontalStackLayout x:Name="GenreChipsContainer"
                                   Spacing="10"
                                   Padding="15">
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Results -->
        <ScrollView x:Name="ResultsScrollView" 
            Grid.Row="2"
            Scrolled="ResultsScrollView_Scrolled">
            <VerticalStackLayout x:Name="MoviesContainer"
                                 Padding="10"
                                 Spacing="10">
                <!-- Movie cards added dynamically -->
            </VerticalStackLayout>
        </ScrollView>
       
        <!-- Loading -->
        <Grid Grid.Row="2" x:Name="LoadingContainer" IsVisible="False">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="15">
                <ActivityIndicator x:Name="LoadingIndicator"
                                   IsRunning="False"
                                   Color="{Binding AccentColor}"
                                   WidthRequest="50"
                                   HeightRequest="50"/>
                <Label Text="Loading movies..."
                       TextColor="{Binding SubtextColor}"
                       FontSize="16"/>
            </VerticalStackLayout>
        </Grid>
        
        <!-- No Results -->
        <VerticalStackLayout Grid.Row="2" 
                             x:Name="NoResultsView"
                             IsVisible="False"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="15">
            <Label Text="🔍"
                   FontSize="48"
                   HorizontalOptions="Center"/>
            <Label Text="No movies found"
                   TextColor="{Binding SubtextColor}"
                   FontSize="18"
                   HorizontalOptions="Center"/>
            <Label Text="Try adjusting your search or filters"
                   TextColor="{Binding SubtextColor}"
                   FontSize="14"
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
